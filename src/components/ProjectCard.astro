---
interface Props {
  href: string;
  title: string;
  summary: string;
  tags: string[];
}

const { href, title, summary, tags } = Astro.props;
---

<a
  href={href}
  data-tags={tags.join(',')}
  class="project-card group flex flex-col gap-3 rounded-xl border border-border bg-surface p-5 transition-all hover:border-accent/60 hover:shadow-[0_1px_0_0_var(--color-accent)]"
>
  <div class="flex flex-wrap items-center gap-2">
    {
      tags.map((tag) => (
        <span class="font-mono text-[0.7rem] uppercase tracking-wider text-accent">
          {tag}
        </span>
      ))
    }
  </div>
  <h3
    class="text-lg font-semibold tracking-tight text-fg transition-colors group-hover:text-accent"
  >
    {title}
  </h3>
  <p class="text-sm leading-relaxed text-muted">{summary}</p>
  <span
    class="mt-1 font-mono text-xs text-faint transition-colors group-hover:text-accent"
  >
    Read case study →
  </span>
</a>
