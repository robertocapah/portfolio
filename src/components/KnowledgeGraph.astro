---
// An animated, interactive knowledge graph: a central "brain" node wired to the
// domains it touches, each wired to the real case studies. Canvas + vanilla JS,
// no libraries. Data comes from the projects collection (passed in as `data`).
interface GraphNode {
  id: string;
  label: string;
  short?: string;
  type: 'root' | 'tag' | 'project';
  slug?: string;
  featured?: boolean;
}
interface GraphEdge {
  source: string;
  target: string;
}
interface Props {
  data: { nodes: GraphNode[]; edges: GraphEdge[] };
}
const { data } = Astro.props;
---

<figure class="kg-figure">
  <div class="kg-wrap">
    <canvas id="kg-canvas" aria-hidden="true"></canvas>
    <noscript>
      <div class="kg-fallback">
        A live map of how my work connects — enable JavaScript to explore it.
      </div>
    </noscript>
  </div>
  <figcaption class="kg-caption">
    Every project wires into the domains it touches — hover to trace a thread,
    click a node to open it.
  </figcaption>
</figure>

<style>
  .kg-figure {
    margin: 0;
  }
  .kg-wrap {
    position: relative;
    width: 100%;
    height: 380px;
    border: 1px solid var(--border);
    border-radius: 1rem;
    background:
      radial-gradient(
        ellipse at 50% 35%,
        color-mix(in srgb, var(--accent) 9%, transparent),
        transparent 65%
      ),
      linear-gradient(
        180deg,
        var(--surface),
        color-mix(in srgb, var(--surface) 60%, var(--bg))
      );
    overflow: hidden;
  }
  @media (min-width: 640px) {
    .kg-wrap {
      height: 460px;
    }
  }
  #kg-canvas {
    display: block;
    width: 100%;
    height: 100%;
  }
  .kg-fallback {
    display: flex;
    height: 100%;
    align-items: center;
    justify-content: center;
    padding: 2rem;
    text-align: center;
    color: var(--muted);
    font-size: 0.9rem;
  }
  .kg-caption {
    margin-top: 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--faint);
  }
</style>

<script is:inline define:vars={{ graphData: data }}>
  (function () {
    const canvas = document.getElementById('kg-canvas');
    if (!canvas || !graphData || !graphData.nodes.length) return;
    const ctx = canvas.getContext('2d');
    const wrap = canvas.parentElement;
    const reduce = window.matchMedia(
      '(prefers-reduced-motion: reduce)',
    ).matches;

    const idx = new Map();
    const nodes = graphData.nodes.map((n, i) => {
      idx.set(n.id, i);
      return { ...n, x: 0, y: 0, vx: 0, vy: 0, lit: 0 };
    });
    const edges = graphData.edges
      .map((e, i) => ({
        s: idx.get(e.source),
        t: idx.get(e.target),
        bow: (i % 2 ? 1 : -1) * (0.10 + (i % 3) * 0.04),
      }))
      .filter((e) => e.s != null && e.t != null);
    const nbr = nodes.map(() => new Set());
    edges.forEach((e) => {
      nbr[e.s].add(e.t);
      nbr[e.t].add(e.s);
    });

    const radiusFor = (n) =>
      n.type === 'root' ? 27 : n.type === 'tag' ? 11 : n.featured ? 16 : 13;
    // Approximate label-chip width so the physics can keep labels from overlapping.
    const chipW = (n) =>
      n.type === 'root' ? 60 : (n.short || n.label).length * 6.6 + 16;

    let W = 0,
      H = 0,
      dpr = 1;
    function resize() {
      const rect = wrap.getBoundingClientRect();
      W = rect.width;
      H = rect.height;
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      canvas.width = W * dpr;
      canvas.height = H * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    }

    let C = {};
    let dark = false;
    function css(v, fb) {
      const val = getComputedStyle(document.documentElement)
        .getPropertyValue(v)
        .trim();
      return val || fb;
    }
    function readColors() {
      dark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      C = {
        accent: css('--accent', '#ea580c'),
        fg: css('--fg', '#1c1917'),
        muted: css('--muted', '#57534e'),
        faint: css('--faint', '#a8a29e'),
        border: css('--border', '#e7e5e4'),
        surface: css('--surface', '#ffffff'),
        bg: css('--bg', '#fafaf9'),
      };
    }
    readColors();

    function init() {
      const cx = W / 2,
        cy = H / 2;
      const spread = Math.min(W, H);
      nodes.forEach((n, i) => {
        const a = (i / nodes.length) * Math.PI * 2;
        const rr =
          n.type === 'root'
            ? 0
            : n.type === 'tag'
              ? spread * 0.18
              : spread * 0.36;
        n.x = cx + Math.cos(a) * rr + (Math.random() - 0.5) * 24;
        n.y = cy + Math.sin(a) * rr + (Math.random() - 0.5) * 24;
        n.vx = 0;
        n.vy = 0;
      });
    }

    function restLen(e) {
      const a = nodes[e.s],
        b = nodes[e.t];
      const s = Math.min(W, H);
      return a.type === 'root' || b.type === 'root' ? s * 0.28 : s * 0.19;
    }

    function step() {
      for (let i = 0; i < nodes.length; i++) {
        for (let j = i + 1; j < nodes.length; j++) {
          let dx = nodes[i].x - nodes[j].x,
            dy = nodes[i].y - nodes[j].y;
          let d2 = dx * dx + dy * dy || 0.01;
          let d = Math.sqrt(d2);
          let f = 5200 / d2;
          nodes[i].vx += (dx / d) * f;
          nodes[i].vy += (dy / d) * f;
          nodes[j].vx -= (dx / d) * f;
          nodes[j].vy -= (dy / d) * f;
        }
      }
      // Label-aware separation: chips hang below nodes, so when two nodes sit in
      // the same horizontal band, push them apart until their chips clear.
      for (let i = 0; i < nodes.length; i++) {
        for (let j = i + 1; j < nodes.length; j++) {
          const a = nodes[i],
            b = nodes[j];
          const dy = a.y - b.y;
          if (Math.abs(dy) > 40) continue;
          const minX = (chipW(a) + chipW(b)) / 2 + 16;
          const dx = a.x - b.x;
          if (Math.abs(dx) < minX) {
            const push = Math.max(
              0.25,
              ((minX - Math.abs(dx)) / minX) * 2.2,
            );
            const sx = dx >= 0 ? 1 : -1;
            a.vx += sx * push;
            b.vx -= sx * push;
            const sy = dy >= 0 ? 1 : -1;
            a.vy += sy * push * 0.5;
            b.vy -= sy * push * 0.5;
          }
        }
      }
      edges.forEach((e) => {
        const a = nodes[e.s],
          b = nodes[e.t];
        let dx = b.x - a.x,
          dy = b.y - a.y;
        let d = Math.sqrt(dx * dx + dy * dy) || 0.01;
        let f = (d - restLen(e)) * 0.02;
        a.vx += (dx / d) * f;
        a.vy += (dy / d) * f;
        b.vx -= (dx / d) * f;
        b.vy -= (dy / d) * f;
      });
      const cx = W / 2,
        cy = H / 2;
      nodes.forEach((n) => {
        n.vx += (cx - n.x) * 0.004;
        n.vy += (cy - n.y) * 0.004;
        if (n.type === 'root') {
          n.vx += (cx - n.x) * 0.08;
          n.vy += (cy - n.y) * 0.08;
        }
        if (!reduce) {
          n.vx += (Math.random() - 0.5) * 0.16;
          n.vy += (Math.random() - 0.5) * 0.16;
        }
        n.vx *= 0.86;
        n.vy *= 0.86;
        const sp = Math.hypot(n.vx, n.vy);
        if (sp > 3) {
          n.vx = (n.vx / sp) * 3;
          n.vy = (n.vy / sp) * 3;
        }
        n.x += n.vx;
        n.y += n.vy;
        const r = radiusFor(n) + 8;
        n.x = Math.max(r, Math.min(W - r, n.x));
        n.y = Math.max(r, Math.min(H - r, n.y));
      });
      // Hard exclusion zone around the root so no chip overlaps the brain.
      const root = nodes.find((n) => n.type === 'root');
      if (root) {
        const keep = 78;
        nodes.forEach((n) => {
          if (n === root) return;
          let dx = n.x - root.x,
            dy = n.y - root.y;
          let d = Math.hypot(dx, dy) || 0.01;
          if (d < keep) {
            n.x = root.x + (dx / d) * keep;
            n.y = root.y + (dy / d) * keep;
          }
        });
      }
    }

    // Curved-edge helpers: quadratic bezier with a perpendicular bow.
    function ctrl(e) {
      const a = nodes[e.s],
        b = nodes[e.t];
      const mx = (a.x + b.x) / 2,
        my = (a.y + b.y) / 2;
      const dx = b.x - a.x,
        dy = b.y - a.y;
      return { x: mx - dy * e.bow, y: my + dx * e.bow };
    }
    function onCurve(e, t) {
      const a = nodes[e.s],
        b = nodes[e.t],
        c = ctrl(e);
      const u = 1 - t;
      return {
        x: u * u * a.x + 2 * u * t * c.x + t * t * b.x,
        y: u * u * a.y + 2 * u * t * c.y + t * t * b.y,
      };
    }

    let pulses = [];
    let lastPulse = 0;
    function spawnPulse() {
      if (!edges.length) return;
      const e = edges[Math.floor(Math.random() * edges.length)];
      pulses.push({ e, t: 0, dir: Math.random() < 0.5 ? 1 : -1 });
    }

    // Ambient motes drifting through the background — pure atmosphere.
    const motes = [];
    function initMotes() {
      motes.length = 0;
      const count = Math.round((W * H) / 14000);
      for (let i = 0; i < count; i++) {
        motes.push({
          x: Math.random() * W,
          y: Math.random() * H,
          vx: (Math.random() - 0.5) * 0.22,
          vy: -0.06 - Math.random() * 0.16,
          r: 0.7 + Math.random() * 1.3,
          ph: Math.random() * Math.PI * 2,
        });
      }
    }
    function drawMotes(now) {
      motes.forEach((m) => {
        m.x += m.vx;
        m.y += m.vy;
        if (m.y < -4) {
          m.y = H + 4;
          m.x = Math.random() * W;
        }
        if (m.x < -4) m.x = W + 4;
        if (m.x > W + 4) m.x = -4;
        const tw = 0.5 + 0.5 * Math.sin(now / 900 + m.ph);
        ctx.beginPath();
        ctx.arc(m.x, m.y, m.r, 0, Math.PI * 2);
        ctx.fillStyle = C.accent;
        ctx.globalAlpha = (dark ? 0.28 : 0.2) * tw;
        ctx.fill();
      });
      ctx.globalAlpha = 1;
    }

    const mouse = { x: -999, y: -999 };
    let hover = -1;
    function pick() {
      let best = -1,
        bd = 1e9;
      for (let i = 0; i < nodes.length; i++) {
        const r = radiusFor(nodes[i]) + 10;
        const d = Math.hypot(nodes[i].x - mouse.x, nodes[i].y - mouse.y);
        if (d < r && d < bd) {
          bd = d;
          best = i;
        }
      }
      return best;
    }
    canvas.addEventListener('mousemove', (ev) => {
      const rect = canvas.getBoundingClientRect();
      mouse.x = ev.clientX - rect.left;
      mouse.y = ev.clientY - rect.top;
      hover = pick();
      canvas.style.cursor =
        hover >= 0 && nodes[hover].slug ? 'pointer' : 'default';
      if (reduce) draw(0);
    });
    canvas.addEventListener('mouseleave', () => {
      mouse.x = mouse.y = -999;
      hover = -1;
      canvas.style.cursor = 'default';
      if (reduce) draw(0);
    });
    canvas.addEventListener('click', () => {
      if (hover >= 0 && nodes[hover].slug)
        window.location.href = nodes[hover].slug;
    });

    function rrect(x, y, w, h, r) {
      ctx.beginPath();
      if (ctx.roundRect) ctx.roundRect(x, y, w, h, r);
      else {
        ctx.moveTo(x + r, y);
        ctx.arcTo(x + w, y, x + w, y + h, r);
        ctx.arcTo(x + w, y + h, x, y + h, r);
        ctx.arcTo(x, y + h, x, y, r);
        ctx.arcTo(x, y, x + w, y, r);
        ctx.closePath();
      }
    }

    function chip(text, x, y, opts) {
      ctx.font =
        (opts.bold ? '600 ' : '500 ') +
        '10.5px "Geist Mono Variable", ui-monospace, monospace';
      const tw = ctx.measureText(text).width;
      const padX = 7,
        hh = 18;
      const bx = x - tw / 2 - padX,
        by = y - hh / 2;
      rrect(bx, by, tw + padX * 2, hh, 9);
      ctx.fillStyle = opts.lit ? C.accent : C.surface;
      ctx.globalAlpha *= opts.lit ? 1 : dark ? 0.72 : 0.9;
      ctx.fill();
      ctx.globalAlpha = opts.alpha;
      ctx.strokeStyle = opts.lit ? C.accent : C.border;
      ctx.lineWidth = 1;
      ctx.stroke();
      ctx.fillStyle = opts.lit ? C.bg : opts.dim ? C.muted : C.fg;
      ctx.textAlign = 'center';
      ctx.textBaseline = 'middle';
      ctx.fillText(text, x, y + 0.5);
    }

    function dotGrid() {
      const gap = 26;
      ctx.fillStyle = C.faint;
      ctx.globalAlpha = dark ? 0.10 : 0.14;
      for (let x = gap / 2; x < W; x += gap)
        for (let y = gap / 2; y < H; y += gap) {
          ctx.beginPath();
          ctx.arc(x, y, 0.8, 0, Math.PI * 2);
          ctx.fill();
        }
      ctx.globalAlpha = 1;
    }

    function draw(now) {
      ctx.clearRect(0, 0, W, H);
      dotGrid();
      if (!reduce) drawMotes(now);

      const active = hover >= 0;
      const near = (i) => !active || hover === i || nbr[hover].has(i);
      nodes.forEach((n, i) => {
        const target = active && (hover === i || nbr[hover].has(i)) ? 1 : 0;
        n.lit += (target - n.lit) * (reduce ? 1 : 0.18);
      });

      // Edges — curved, gradient, glowing when lit.
      edges.forEach((e) => {
        const a = nodes[e.s],
          b = nodes[e.t],
          c = ctrl(e);
        const lit = active && (e.s === hover || e.t === hover);
        const grad = ctx.createLinearGradient(a.x, a.y, b.x, b.y);
        if (lit) {
          grad.addColorStop(0, C.accent);
          grad.addColorStop(1, C.accent);
        } else {
          grad.addColorStop(0, C.border);
          grad.addColorStop(0.5, C.faint);
          grad.addColorStop(1, C.border);
        }
        ctx.beginPath();
        ctx.moveTo(a.x, a.y);
        ctx.quadraticCurveTo(c.x, c.y, b.x, b.y);
        ctx.strokeStyle = grad;
        ctx.globalAlpha = active ? (lit ? 0.95 : 0.14) : 0.5;
        ctx.lineWidth = lit ? 1.7 : 1;
        if (lit) {
          ctx.shadowColor = C.accent;
          ctx.shadowBlur = 8;
        }
        ctx.stroke();
        ctx.shadowBlur = 0;
      });
      ctx.globalAlpha = 1;

      // Pulses — comet head + fading tail, travelling along the curve.
      pulses.forEach((p) => {
        for (let k = 0; k < 5; k++) {
          const tt = Math.max(
            0,
            Math.min(1, (p.dir > 0 ? p.t : 1 - p.t) - k * 0.03 * p.dir),
          );
          const pos = onCurve(p.e, tt);
          ctx.beginPath();
          ctx.arc(pos.x, pos.y, k === 0 ? 2.4 : 2 - k * 0.35, 0, Math.PI * 2);
          ctx.fillStyle = C.accent;
          ctx.globalAlpha = k === 0 ? 0.95 : 0.5 - k * 0.1;
          if (k === 0) {
            ctx.shadowColor = C.accent;
            ctx.shadowBlur = 12;
          }
          ctx.fill();
          ctx.shadowBlur = 0;
        }
      });
      ctx.globalAlpha = 1;

      // Nodes.
      nodes.forEach((n, i) => {
        const r = radiusFor(n);
        const base = near(i) ? 1 : 0.22;
        ctx.globalAlpha = base;

        if (n.type === 'root') {
          // Breathing halo rings.
          if (!reduce) {
            for (let k = 0; k < 2; k++) {
              const ph = ((now / 2600 + k * 0.5) % 1 + 1) % 1;
              ctx.beginPath();
              ctx.arc(n.x, n.y, r + 4 + ph * 26, 0, Math.PI * 2);
              ctx.strokeStyle = C.accent;
              ctx.globalAlpha = base * 0.35 * (1 - ph);
              ctx.lineWidth = 1.2;
              ctx.stroke();
            }
            ctx.globalAlpha = base;
          }
          const g = ctx.createRadialGradient(
            n.x - r * 0.35,
            n.y - r * 0.4,
            r * 0.2,
            n.x,
            n.y,
            r,
          );
          g.addColorStop(0, dark ? '#fdba74' : '#fb923c');
          g.addColorStop(1, C.accent);
          ctx.beginPath();
          ctx.arc(n.x, n.y, r, 0, Math.PI * 2);
          ctx.fillStyle = g;
          ctx.shadowColor = C.accent;
          ctx.shadowBlur = 22;
          ctx.fill();
          ctx.shadowBlur = 0;
          ctx.fillStyle = dark ? '#0c0a09' : '#ffffff';
          ctx.font = '600 12px "Geist Variable", ui-sans-serif, sans-serif';
          ctx.textAlign = 'center';
          ctx.textBaseline = 'middle';
          ctx.fillText(n.label, n.x, n.y + 0.5);
        } else {
          const isTag = n.type === 'tag';
          const litAmt = n.lit;
          // Soft glow behind lit / hovered nodes.
          if (litAmt > 0.05) {
            ctx.beginPath();
            ctx.arc(n.x, n.y, r + 6, 0, Math.PI * 2);
            ctx.fillStyle = C.accent;
            ctx.globalAlpha = base * 0.16 * litAmt;
            ctx.fill();
            ctx.globalAlpha = base;
          }
          ctx.beginPath();
          ctx.arc(n.x, n.y, r, 0, Math.PI * 2);
          ctx.fillStyle = hover === i ? C.accent : C.surface;
          if (hover === i) {
            ctx.shadowColor = C.accent;
            ctx.shadowBlur = 16;
          }
          ctx.fill();
          ctx.shadowBlur = 0;
          ctx.lineWidth = isTag ? 1.6 : 1.3;
          ctx.strokeStyle =
            hover === i
              ? C.accent
              : litAmt > 0.4
                ? C.accent
                : isTag
                  ? C.faint
                  : C.border;
          ctx.stroke();
          // Inner accent dot for domain hubs.
          if (isTag && hover !== i) {
            ctx.beginPath();
            ctx.arc(n.x, n.y, 3.2, 0, Math.PI * 2);
            ctx.fillStyle = C.accent;
            ctx.fill();
          }

          if (near(i)) {
            const lit = hover === i || (active && nbr[hover].has(i));
            chip(n.short || n.label, n.x, n.y + r + 15, {
              lit: hover === i,
              bold: isTag,
              dim: !isTag && !lit,
              alpha: base,
            });
          }
        }
        ctx.globalAlpha = 1;
      });
    }

    let raf = 0,
      running = false,
      visible = true;
    function frame(now) {
      if (!running) return;
      step();
      if (now - lastPulse > 300 && visible) {
        spawnPulse();
        if (Math.random() < 0.35) spawnPulse();
        lastPulse = now;
      }
      pulses.forEach((p) => (p.t += 0.014));
      pulses = pulses.filter((p) => p.t < 1);
      draw(now);
      raf = requestAnimationFrame(frame);
    }
    function start() {
      if (running || reduce) return;
      running = true;
      raf = requestAnimationFrame(frame);
    }
    function stop() {
      running = false;
      cancelAnimationFrame(raf);
    }

    function recenter() {
      let mx = 0,
        my = 0;
      nodes.forEach((n) => {
        mx += n.x;
        my += n.y;
      });
      mx /= nodes.length;
      my /= nodes.length;
      const dx = W / 2 - mx,
        dy = H / 2 - my;
      nodes.forEach((n) => {
        n.x += dx;
        n.y += dy;
      });
    }

    resize();
    init();
    initMotes();
    for (let k = 0; k < (reduce ? 220 : 60); k++) step();
    recenter();
    draw(0);

    if (!reduce) {
      const io = new IntersectionObserver(
        ([e]) => {
          visible = e.isIntersecting;
          visible ? start() : stop();
        },
        { threshold: 0.05 },
      );
      io.observe(wrap);
      document.addEventListener('visibilitychange', () => {
        if (document.hidden) stop();
        else if (visible) start();
      });
    }

    let rt;
    window.addEventListener('resize', () => {
      clearTimeout(rt);
      rt = setTimeout(() => {
        resize();
        initMotes();
        if (reduce) {
          init();
          for (let k = 0; k < 220; k++) step();
          recenter();
          draw(0);
        }
      }, 150);
    });
    window
      .matchMedia('(prefers-color-scheme: dark)')
      .addEventListener('change', () => {
        readColors();
        if (reduce) draw(0);
      });
  })();
</script>
