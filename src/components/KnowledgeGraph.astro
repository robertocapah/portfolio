---
// An animated, interactive knowledge graph: a central "brain" node wired to the
// domains it touches, each wired to the real case studies. Canvas + vanilla JS,
// no libraries. Data comes from the projects collection (passed in as `data`).
interface GraphNode {
  id: string;
  label: string;
  short?: string;
  type: 'root' | 'tag' | 'project';
  slug?: string;
  featured?: boolean;
}
interface GraphEdge {
  source: string;
  target: string;
}
interface Props {
  data: { nodes: GraphNode[]; edges: GraphEdge[] };
}
const { data } = Astro.props;
---

<figure class="kg-figure">
  <div class="kg-wrap">
    <canvas id="kg-canvas" aria-hidden="true"></canvas>
    <noscript>
      <div class="kg-fallback">
        A live map of how my work connects — enable JavaScript to explore it.
      </div>
    </noscript>
  </div>
  <figcaption class="kg-caption">
    Every project wires into the domains it touches — hover to trace a thread,
    click a node to open it.
  </figcaption>
</figure>

<style>
  .kg-figure {
    margin: 0;
  }
  .kg-wrap {
    position: relative;
    width: 100%;
    height: 380px;
    border: 1px solid var(--border);
    border-radius: 0.75rem;
    background:
      radial-gradient(
        ellipse at 50% 40%,
        color-mix(in srgb, var(--accent) 7%, transparent),
        transparent 70%
      ),
      var(--surface);
    overflow: hidden;
  }
  @media (min-width: 640px) {
    .kg-wrap {
      height: 460px;
    }
  }
  #kg-canvas {
    display: block;
    width: 100%;
    height: 100%;
  }
  .kg-fallback {
    display: flex;
    height: 100%;
    align-items: center;
    justify-content: center;
    padding: 2rem;
    text-align: center;
    color: var(--muted);
    font-size: 0.9rem;
  }
  .kg-caption {
    margin-top: 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--faint);
  }
</style>

<script is:inline define:vars={{ graphData: data }}>
  (function () {
    const canvas = document.getElementById('kg-canvas');
    if (!canvas || !graphData || !graphData.nodes.length) return;
    const ctx = canvas.getContext('2d');
    const wrap = canvas.parentElement;
    const reduce = window.matchMedia(
      '(prefers-reduced-motion: reduce)',
    ).matches;

    const idx = new Map();
    const nodes = graphData.nodes.map((n, i) => {
      idx.set(n.id, i);
      return { ...n, x: 0, y: 0, vx: 0, vy: 0 };
    });
    const edges = graphData.edges
      .map((e) => ({ s: idx.get(e.source), t: idx.get(e.target) }))
      .filter((e) => e.s != null && e.t != null);
    const nbr = nodes.map(() => new Set());
    edges.forEach((e) => {
      nbr[e.s].add(e.t);
      nbr[e.t].add(e.s);
    });

    const radiusFor = (n) =>
      n.type === 'root' ? 26 : n.type === 'tag' ? 12 : n.featured ? 19 : 16;

    let W = 0,
      H = 0,
      dpr = 1;
    function resize() {
      const rect = wrap.getBoundingClientRect();
      W = rect.width;
      H = rect.height;
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      canvas.width = W * dpr;
      canvas.height = H * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    }

    let C = {};
    function css(v, fb) {
      const val = getComputedStyle(document.documentElement)
        .getPropertyValue(v)
        .trim();
      return val || fb;
    }
    function readColors() {
      C = {
        accent: css('--accent', '#ea580c'),
        fg: css('--fg', '#1c1917'),
        muted: css('--muted', '#57534e'),
        border: css('--border', '#e7e5e4'),
        surface: css('--surface', '#ffffff'),
        bg: css('--bg', '#fafaf9'),
      };
    }
    readColors();

    function init() {
      const cx = W / 2,
        cy = H / 2;
      const spread = Math.min(W, H);
      nodes.forEach((n, i) => {
        const a = (i / nodes.length) * Math.PI * 2;
        const rr =
          n.type === 'root'
            ? 0
            : n.type === 'tag'
              ? spread * 0.18
              : spread * 0.36;
        n.x = cx + Math.cos(a) * rr + (Math.random() - 0.5) * 24;
        n.y = cy + Math.sin(a) * rr + (Math.random() - 0.5) * 24;
        n.vx = 0;
        n.vy = 0;
      });
    }

    function restLen(e) {
      const a = nodes[e.s],
        b = nodes[e.t];
      const s = Math.min(W, H);
      return a.type === 'root' || b.type === 'root' ? s * 0.26 : s * 0.17;
    }

    function step() {
      for (let i = 0; i < nodes.length; i++) {
        for (let j = i + 1; j < nodes.length; j++) {
          let dx = nodes[i].x - nodes[j].x,
            dy = nodes[i].y - nodes[j].y;
          let d2 = dx * dx + dy * dy || 0.01;
          let d = Math.sqrt(d2);
          let f = 3600 / d2;
          nodes[i].vx += (dx / d) * f;
          nodes[i].vy += (dy / d) * f;
          nodes[j].vx -= (dx / d) * f;
          nodes[j].vy -= (dy / d) * f;
        }
      }
      edges.forEach((e) => {
        const a = nodes[e.s],
          b = nodes[e.t];
        let dx = b.x - a.x,
          dy = b.y - a.y;
        let d = Math.sqrt(dx * dx + dy * dy) || 0.01;
        let f = (d - restLen(e)) * 0.02;
        a.vx += (dx / d) * f;
        a.vy += (dy / d) * f;
        b.vx -= (dx / d) * f;
        b.vy -= (dy / d) * f;
      });
      const cx = W / 2,
        cy = H / 2;
      nodes.forEach((n) => {
        n.vx += (cx - n.x) * 0.004;
        n.vy += (cy - n.y) * 0.004;
        if (n.type === 'root') {
          n.vx += (cx - n.x) * 0.08;
          n.vy += (cy - n.y) * 0.08;
        }
        if (!reduce) {
          n.vx += (Math.random() - 0.5) * 0.16;
          n.vy += (Math.random() - 0.5) * 0.16;
        }
        n.vx *= 0.86;
        n.vy *= 0.86;
        const sp = Math.hypot(n.vx, n.vy);
        if (sp > 3) {
          n.vx = (n.vx / sp) * 3;
          n.vy = (n.vy / sp) * 3;
        }
        n.x += n.vx;
        n.y += n.vy;
        const r = radiusFor(n) + 8;
        n.x = Math.max(r, Math.min(W - r, n.x));
        n.y = Math.max(r, Math.min(H - r, n.y));
      });
    }

    let pulses = [];
    let lastPulse = 0;
    function spawnPulse() {
      if (!edges.length) return;
      const e = edges[Math.floor(Math.random() * edges.length)];
      pulses.push({ e, t: 0, dir: Math.random() < 0.5 ? 1 : -1 });
    }

    const mouse = { x: -999, y: -999 };
    let hover = -1;
    function pick() {
      let best = -1,
        bd = 1e9;
      for (let i = 0; i < nodes.length; i++) {
        const r = radiusFor(nodes[i]) + 8;
        const d = Math.hypot(nodes[i].x - mouse.x, nodes[i].y - mouse.y);
        if (d < r && d < bd) {
          bd = d;
          best = i;
        }
      }
      return best;
    }
    canvas.addEventListener('mousemove', (ev) => {
      const rect = canvas.getBoundingClientRect();
      mouse.x = ev.clientX - rect.left;
      mouse.y = ev.clientY - rect.top;
      hover = pick();
      canvas.style.cursor = hover >= 0 && nodes[hover].slug ? 'pointer' : 'default';
      if (reduce) draw();
    });
    canvas.addEventListener('mouseleave', () => {
      mouse.x = mouse.y = -999;
      hover = -1;
      canvas.style.cursor = 'default';
      if (reduce) draw();
    });
    canvas.addEventListener('click', () => {
      if (hover >= 0 && nodes[hover].slug) window.location.href = nodes[hover].slug;
    });

    function draw() {
      ctx.clearRect(0, 0, W, H);
      const active = hover >= 0;
      const near = (i) => !active || hover === i || nbr[hover].has(i);

      edges.forEach((e) => {
        const a = nodes[e.s],
          b = nodes[e.t];
        const lit = active && (e.s === hover || e.t === hover);
        ctx.beginPath();
        ctx.moveTo(a.x, a.y);
        ctx.lineTo(b.x, b.y);
        ctx.strokeStyle = lit ? C.accent : C.border;
        ctx.globalAlpha = active ? (lit ? 0.9 : 0.2) : 0.55;
        ctx.lineWidth = lit ? 1.6 : 1;
        ctx.stroke();
      });
      ctx.globalAlpha = 1;

      pulses.forEach((p) => {
        const a = nodes[p.e.s],
          b = nodes[p.e.t];
        const tt = p.dir > 0 ? p.t : 1 - p.t;
        const x = a.x + (b.x - a.x) * tt,
          y = a.y + (b.y - a.y) * tt;
        ctx.beginPath();
        ctx.arc(x, y, 2.6, 0, Math.PI * 2);
        ctx.fillStyle = C.accent;
        ctx.shadowColor = C.accent;
        ctx.shadowBlur = 10;
        ctx.fill();
        ctx.shadowBlur = 0;
      });

      nodes.forEach((n, i) => {
        const r = radiusFor(n);
        ctx.globalAlpha = near(i) ? 1 : 0.28;
        if (n.type === 'root') ctx.fillStyle = C.accent;
        else if (hover === i) ctx.fillStyle = C.accent;
        else ctx.fillStyle = C.surface;
        ctx.beginPath();
        ctx.arc(n.x, n.y, r, 0, Math.PI * 2);
        ctx.fill();
        ctx.lineWidth = 1.5;
        ctx.strokeStyle =
          n.type === 'root' ? C.accent : hover === i ? C.accent : C.border;
        ctx.stroke();

        if (near(i)) {
          ctx.textAlign = 'center';
          ctx.textBaseline = 'middle';
          if (n.type === 'root') {
            ctx.fillStyle = C.bg;
            ctx.font = '600 12px "Geist Variable", ui-sans-serif, sans-serif';
            ctx.fillText(n.label, n.x, n.y);
          } else {
            const lit = hover === i || (active && nbr[hover].has(i));
            ctx.fillStyle = n.type === 'tag' ? C.fg : lit ? C.fg : C.muted;
            ctx.font =
              (n.type === 'tag' ? '600 11px' : '500 11px') +
              ' "Geist Variable", ui-sans-serif, sans-serif';
            ctx.fillText(n.short || n.label, n.x, n.y + r + 11);
          }
        }
      });
      ctx.globalAlpha = 1;
    }

    let raf = 0,
      running = false,
      visible = true;
    function frame(now) {
      if (!running) return;
      step();
      if (now - lastPulse > 850 && visible) {
        spawnPulse();
        lastPulse = now;
      }
      pulses.forEach((p) => (p.t += 0.016));
      pulses = pulses.filter((p) => p.t < 1);
      draw();
      raf = requestAnimationFrame(frame);
    }
    function start() {
      if (running || reduce) return;
      running = true;
      raf = requestAnimationFrame(frame);
    }
    function stop() {
      running = false;
      cancelAnimationFrame(raf);
    }

    function recenter() {
      let mx = 0,
        my = 0;
      nodes.forEach((n) => {
        mx += n.x;
        my += n.y;
      });
      mx /= nodes.length;
      my /= nodes.length;
      const dx = W / 2 - mx,
        dy = H / 2 - my;
      nodes.forEach((n) => {
        n.x += dx;
        n.y += dy;
      });
    }

    resize();
    init();
    for (let k = 0; k < (reduce ? 220 : 60); k++) step();
    recenter();
    draw();

    if (!reduce) {
      const io = new IntersectionObserver(
        ([e]) => {
          visible = e.isIntersecting;
          visible ? start() : stop();
        },
        { threshold: 0.05 },
      );
      io.observe(wrap);
      document.addEventListener('visibilitychange', () => {
        if (document.hidden) stop();
        else if (visible) start();
      });
    }

    let rt;
    window.addEventListener('resize', () => {
      clearTimeout(rt);
      rt = setTimeout(() => {
        resize();
        if (reduce) {
          init();
          for (let k = 0; k < 220; k++) step();
          draw();
        }
      }, 150);
    });
    window
      .matchMedia('(prefers-color-scheme: dark)')
      .addEventListener('change', () => {
        readColors();
        if (reduce) draw();
      });
  })();
</script>
