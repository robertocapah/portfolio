---
const year = new Date().getFullYear();
const links = [
  { href: 'https://github.com/robertocapah', label: 'GitHub' },
  { href: 'https://www.linkedin.com/in/robertocapah', label: 'LinkedIn' },
  { href: 'mailto:roberto.capah@gmail.com', label: 'Email' },
];
---

<footer class="border-t border-border">
  <div
    class="mx-auto flex max-w-3xl flex-col gap-4 px-6 py-8 text-sm text-muted sm:flex-row sm:items-center sm:justify-between"
  >
    <p class="font-mono text-xs text-faint">
      © {year} Roberto Capah · Built with Astro, shipped with AI.
    </p>
    <ul class="flex gap-5">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              class="transition-colors hover:text-accent"
              rel="me noopener"
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</footer>
