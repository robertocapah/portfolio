---
const links = [
  { href: '/projects', label: 'Projects' },
  { href: '/ai', label: 'How I ship with AI' },
  { href: '/about', label: 'About' },
];

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href);
---

<header
  class="sticky top-0 z-50 border-b border-border bg-bg/80 backdrop-blur-md"
>
  <nav
    class="mx-auto flex max-w-3xl items-center justify-between px-6 py-4"
  >
    <a
      href="/"
      class="font-mono text-sm font-medium tracking-tight text-fg transition-colors hover:text-accent"
    >
      <span class="text-accent">~/</span>roberto
    </a>
    <ul class="flex items-center gap-5 sm:gap-7">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              class:list={[
                'text-sm transition-colors hover:text-fg',
                isActive(link.href) ? 'text-fg' : 'text-muted',
              ]}
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>
