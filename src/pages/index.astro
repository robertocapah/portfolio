---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import KnowledgeGraph from '../components/KnowledgeGraph.astro';

const allProjects = (await getCollection('projects')).filter(
  (p) => !p.data.draft,
);

const featured = allProjects
  .filter((p) => p.data.featured)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const latestLog = (await getCollection('changelog'))
  .filter((e) => !e.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 2);

// Knowledge graph: brain (root) → domains (tags) → case studies (projects).
const TAGS = ['AI Agents', 'CI/CD', 'Security', 'Tooling'];
const SHORT: Record<string, string> = {
  'crash-to-huly-pipeline': 'Crash→Task Pipeline',
  'ai-agent-fleet': 'AI Agent Fleet',
  'agentic-release-workflow': 'Agentic Release',
  'cicd-engineering': 'CI/CD Engineering',
  'security-flow-audit': 'Security Audit',
  'design-tokens-pipeline': 'Design Tokens',
};
const graphData = {
  nodes: [
    { id: 'root', label: 'Roberto', type: 'root' as const },
    ...TAGS.map((t) => ({ id: `tag:${t}`, label: t, type: 'tag' as const })),
    ...allProjects.map((p) => ({
      id: `proj:${p.id}`,
      label: p.data.title,
      short: SHORT[p.id] ?? p.data.title,
      type: 'project' as const,
      slug: `/projects/${p.id}`,
      featured: p.data.featured,
    })),
  ],
  edges: [
    ...TAGS.map((t) => ({ source: 'root', target: `tag:${t}` })),
    ...allProjects.flatMap((p) =>
      p.data.tags.map((t) => ({ source: `tag:${t}`, target: `proj:${p.id}` })),
    ),
  ],
};
---

<Base
  title="Roberto Capah — Lead Android Engineer shipping with AI"
  description="Lead Android Engineer at Bareksa. I own the AI agent fleets, agentic release workflows, and CI/CD infrastructure my team ships with — and build production software with an AI pair."
>
  <section class="flex flex-col gap-6">
    <p class="eyebrow">Lead Android Engineer · Jakarta</p>
    <h1
      class="text-4xl font-semibold leading-[1.1] tracking-tight text-fg sm:text-5xl"
    >
      I build production Android software —
      <span class="text-accent">and the AI systems that ship it.</span>
    </h1>
    <p class="max-w-xl text-lg leading-relaxed text-muted">
      I'm Roberto, a Lead Android Engineer at Bareksa, an Indonesian investment
      super-app. Beyond shipping features, I own the AI agent fleets, agentic
      release workflows, and CI/CD infrastructure my team builds on — treating
      AI as a teammate I engineer around, not a novelty.
    </p>
    <div class="mt-2 flex flex-wrap gap-3">
      <a
        href="/projects"
        class="rounded-lg bg-accent px-4 py-2 text-sm font-medium text-on-accent transition-opacity hover:opacity-90"
      >
        View the work
      </a>
      <a
        href="/ai"
        class="rounded-lg border border-border px-4 py-2 text-sm font-medium text-fg transition-colors hover:border-accent/60"
      >
        How I ship with AI
      </a>
    </div>
  </section>

  <section class="mt-20">
    <h2 class="mb-6 text-sm font-semibold uppercase tracking-wider text-faint">
      How it all connects
    </h2>
    <KnowledgeGraph data={graphData} />
  </section>

  <section class="mt-20">
    <div class="mb-6 flex items-baseline justify-between">
      <h2 class="text-sm font-semibold uppercase tracking-wider text-faint">
        Featured work
      </h2>
      <a
        href="/projects"
        class="font-mono text-xs text-muted transition-colors hover:text-accent"
      >
        all projects →
      </a>
    </div>
    <div class="flex flex-col gap-4">
      {
        featured.map((p) => (
          <ProjectCard
            href={`/projects/${p.id}`}
            title={p.data.title}
            summary={p.data.summary}
            tags={p.data.tags}
          />
        ))
      }
    </div>
  </section>

  {
    latestLog.length > 0 && (
      <section class="mt-20">
        <div class="mb-6 flex items-baseline justify-between">
          <h2 class="text-sm font-semibold uppercase tracking-wider text-faint">
            Latest from the log
          </h2>
          <a
            href="/log"
            class="font-mono text-xs text-muted transition-colors hover:text-accent"
          >
            full log →
          </a>
        </div>
        <ul class="flex flex-col divide-y divide-border rounded-xl border border-border bg-surface">
          {latestLog.map((e) => (
            <li>
              <a
                href="/log"
                class="group flex items-baseline gap-4 px-5 py-4 transition-colors hover:bg-surface-2"
              >
                <time class="shrink-0 font-mono text-xs text-faint">
                  {e.data.date.toLocaleDateString('en-US', {
                    month: 'short',
                    day: 'numeric',
                  })}
                </time>
                <span class="text-sm text-muted transition-colors group-hover:text-fg">
                  {e.data.title}
                </span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }
</Base>
