---
import Base from '../layouts/Base.astro';
---

<Base
  title="404 — Not found"
  description="This page doesn't exist."
>
  <section class="flex min-h-[40vh] flex-col items-start justify-center gap-4">
    <p class="eyebrow">Error 404</p>
    <h1 class="text-4xl font-semibold tracking-tight text-fg">
      This page took an <span class="text-accent">unhandled exception.</span>
    </h1>
    <p class="max-w-md text-lg leading-relaxed text-muted">
      The page you're looking for doesn't exist — or it was moved. Let's get you
      back on a happy path.
    </p>
    <div class="mt-2 flex flex-wrap gap-3">
      <a
        href="/"
        class="rounded-lg bg-accent px-4 py-2 text-sm font-medium text-on-accent transition-opacity hover:opacity-90"
      >
        Go home
      </a>
      <a
        href="/projects"
        class="rounded-lg border border-border px-4 py-2 text-sm font-medium text-fg transition-colors hover:border-accent/60"
      >
        See the projects
      </a>
    </div>
  </section>
</Base>
