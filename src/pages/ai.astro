---
import Base from '../layouts/Base.astro';

// Commit velocity, counted from git history (monthly commits, 2026).
// `ai` = commits with a "Co-Authored-By: Claude" trailer. First one: 2026-04-30.
const series = [
  { month: 'Jan', commits: 24, ai: 0 },
  { month: 'Feb', commits: 58, ai: 0 },
  { month: 'Mar', commits: 27, ai: 0 },
  { month: 'Apr', commits: 68, ai: 8 },
  { month: 'May', commits: 97, ai: 71 },
  { month: 'Jun', commits: 152, ai: 116 },
  { month: 'Jul*', commits: 126, ai: 81, partial: true },
];
const baseline = 30; // 2025 monthly average, same repo, pre-AI.

// Chart geometry (static SVG, no chart library).
const W = 640;
const H = 280;
const padX = 44;
const padTop = 24;
const padBottom = 40;
const plotW = W - padX - 16;
const plotH = H - padTop - padBottom;
const maxVal = 160;
const barGap = 16;
const barW = (plotW - barGap * (series.length - 1)) / series.length;
const yFor = (v: number) => padTop + plotH - (v / maxVal) * plotH;
const gridLines = [0, 40, 80, 120, 160];

const timeline = [
  {
    phase: 'Assistant',
    when: 'Apr 2026',
    body: 'First AI-co-authored commit lands April 30 — AI as an autocomplete-plus: snippets, boilerplate, quick lookups. Useful, but I still drove every keystroke.',
  },
  {
    phase: 'Pair',
    when: 'May 2026',
    body: 'Shifted to pairing: describing intent, reviewing generated diffs, and letting AI hold context across a whole change. 71 of 97 commits that month were AI-paired.',
  },
  {
    phase: 'Fleet',
    when: 'Jun 2026',
    body: 'Built specialised agents that own a single job against my project’s real conventions — crash hunting, security audits, style enforcement, review, tests, releases. Peak month: 152 commits.',
  },
  {
    phase: 'Systems',
    when: 'Jul 2026',
    body: 'Now I engineer the systems AI runs inside — agentic release workflows, a crash-to-task pipeline, CI infrastructure — so the careful path is automatic, not optional. Three new standalone repos shipped this way.',
  },
];
---

<Base
  title="How I ship with AI — Roberto Capah"
  description="From AI-as-autocomplete to engineering the systems AI runs inside. My AI-adoption timeline and a ~5x commit-velocity increase, told honestly."
>
  <section class="flex flex-col gap-5">
    <p class="eyebrow">Working Method</p>
    <h1 class="text-3xl font-semibold tracking-tight text-fg sm:text-4xl">
      How I ship with AI
    </h1>
    <p class="max-w-xl text-lg leading-relaxed text-muted">
      I treat AI as a teammate I engineer around — not a magic button. The value
      isn't the code it types; it's the repeatable, reviewable systems you can
      build once you stop typing and start orchestrating.
    </p>
  </section>

  <section class="mt-14">
    <h2 class="text-sm font-semibold uppercase tracking-wider text-faint">
      Commit velocity, 2026
    </h2>
    <p class="mt-2 max-w-xl text-sm leading-relaxed text-muted">
      My first AI-co-authored commit landed <strong class="text-fg"
        >April 30, 2026</strong
      >. Two months later, monthly volume hit
      <strong class="text-fg">152 commits</strong> — roughly
      <strong class="text-fg">5×</strong> my 2025 average of ~30. The orange
      share is counted straight from git
      <code class="font-mono text-xs">Co-Authored-By</code> trailers, not
      estimated. Volume isn't quality, but it tracks how much more ground the
      same hours now cover.
    </p>

    <figure
      class="mt-6 rounded-xl border border-border bg-surface p-4 sm:p-6"
    >
      <svg
        viewBox={`0 0 ${W} ${H}`}
        class="h-auto w-full"
        role="img"
        aria-label="Bar chart of monthly commits in 2026, rising from 26 in January to 124 in June."
      >
        {
          gridLines.map((g) => (
            <g>
              <line
                x1={padX}
                x2={W - 16}
                y1={yFor(g)}
                y2={yFor(g)}
                stroke="var(--color-border)"
                stroke-width="1"
              />
              <text
                x={padX - 10}
                y={yFor(g) + 4}
                text-anchor="end"
                font-family="var(--font-mono)"
                font-size="11"
                fill="var(--color-faint)"
              >
                {g}
              </text>
            </g>
          ))
        }
        {
          series.map((d, i) => {
            const x = padX + i * (barW + barGap);
            const yTotal = yFor(d.commits);
            const hTotal = padTop + plotH - yTotal;
            const yAi = yFor(d.ai);
            const hAi = padTop + plotH - yAi;
            const dim = d.partial ? '0.55' : '1';
            return (
              <g opacity={dim}>
                <rect
                  x={x}
                  y={yTotal}
                  width={barW}
                  height={hTotal}
                  rx="4"
                  fill="var(--color-faint)"
                  opacity="0.38"
                />
                {d.ai > 0 && (
                  <rect
                    x={x}
                    y={yAi}
                    width={barW}
                    height={hAi}
                    rx="4"
                    fill="var(--color-accent)"
                  />
                )}
                <text
                  x={x + barW / 2}
                  y={yTotal - 8}
                  text-anchor="middle"
                  font-family="var(--font-mono)"
                  font-size="12"
                  fill="var(--color-fg)"
                >
                  {d.commits}
                </text>
                <text
                  x={x + barW / 2}
                  y={H - 16}
                  text-anchor="middle"
                  font-family="var(--font-mono)"
                  font-size="12"
                  fill="var(--color-muted)"
                >
                  {d.month}
                </text>
              </g>
            );
          })
        }
        <line
          x1={padX}
          x2={W - 16}
          y1={yFor(baseline)}
          y2={yFor(baseline)}
          stroke="var(--color-fg)"
          stroke-width="1"
          stroke-dasharray="5 4"
          opacity="0.5"
        />
        <text
          x={W - 20}
          y={yFor(baseline) - 6}
          text-anchor="end"
          font-family="var(--font-mono)"
          font-size="10.5"
          fill="var(--color-muted)"
        >
          2025 avg (~30)
        </text>
      </svg>
      <div
        class="mt-4 flex flex-wrap items-center gap-x-5 gap-y-2 font-mono text-xs text-muted"
      >
        <span class="flex items-center gap-2">
          <span class="inline-block h-2.5 w-2.5 rounded-[2px] bg-accent"></span>
          AI pair-programmed (git co-author trailer)
        </span>
        <span class="flex items-center gap-2">
          <span
            class="inline-block h-2.5 w-2.5 rounded-[2px] bg-faint opacity-40"
          ></span>
          solo
        </span>
      </div>
      <figcaption class="mt-3 font-mono text-xs text-faint">
        Monthly commits · Jan–Jul 2026 · counted from git history · *Jul is
        month-to-date
      </figcaption>
    </figure>
  </section>

  <section class="mt-16">
    <h2 class="text-sm font-semibold uppercase tracking-wider text-faint">
      The adoption arc
    </h2>
    <ol class="mt-6 flex flex-col gap-0">
      {
        timeline.map((t, i) => (
          <li class="relative flex gap-5 pb-8 last:pb-0">
            <div class="flex flex-col items-center">
              <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-accent bg-accent-soft font-mono text-xs text-accent">
                {i + 1}
              </span>
              {i < timeline.length - 1 && (
                <span class="mt-1 w-px flex-1 bg-border" />
              )}
            </div>
            <div class="flex flex-col gap-1.5 pt-1">
              <h3 class="font-semibold tracking-tight text-fg">
                {t.phase}
                <span class="ml-2 font-mono text-xs font-normal text-faint">
                  {t.when}
                </span>
              </h3>
              <p class="text-sm leading-relaxed text-muted">{t.body}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  <section
    class="mt-16 grid grid-cols-2 gap-4 sm:grid-cols-4"
    aria-label="Key numbers"
  >
    {
      [
        { n: '7', l: 'custom AI agents' },
        { n: '276+', l: 'AI-paired commits' },
        { n: '57', l: 'indexed bugfix docs' },
        { n: '~5×', l: 'commit velocity' },
      ].map((s) => (
        <div class="rounded-xl border border-border bg-surface p-5">
          <div class="font-mono text-3xl font-semibold text-accent">{s.n}</div>
          <div class="mt-1 text-sm text-muted">{s.l}</div>
        </div>
      ))
    }
  </section>

  <section class="mt-16 border-t border-border pt-8">
    <p class="max-w-xl text-lg leading-relaxed text-muted">
      Want the detail? The
      <a href="/projects" class="text-accent underline underline-offset-4"
        >case studies</a
      > break down exactly what I built and why.
    </p>
  </section>
</Base>
